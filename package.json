{
  "name": "system-app",
  "version": "0.1.0",
  "private": true,
  "description": "System \u2014 a personal daily-accomplishment tracker by Arnab Saha.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:init": "psql \"$DATABASE_URL\" -f schema.sql",
    "db:seed": "tsx scripts/seed.ts",
    "verify:dates": "tsx scripts/verify-date-logic.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "postgres": "3.4.9",
    "lucide-react": "1.31.0",
    "@fontsource/roboto-mono": "5.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.28",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tsx": "4.23.15"
  },
  "browserslist": [
    "iOS >= 15",
    "Safari >= 15",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "not dead"
  ]
}
