# Neon connection string (Project -> Connection Details -> "Pooled connection")
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/system?sslmode=require"

# Brevo -> SMTP & API -> API Keys. Free tier: 300 emails/day, no card needed.
BREVO_API_KEY=""
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs ->
# Senders). Verifying your own inbox is enough — no domain/DNS setup needed.
BREVO_SENDER_EMAIL="arnabsahawrk@gmail.com"
BREVO_SENDER_NAME="System"

# Any long random string; Vercel Cron sends it as a bearer token so the
# rollover endpoint can't be triggered by a stranger who finds the URL.
CRON_SECRET="replace-me"

# Any long random string; encrypts the app passcode at rest so it can be
# recovered by email (see "forgot passcode") instead of only ever reset.
# Changing this after a passcode is already set locks it out permanently —
# set it once and leave it.
PASSCODE_KEY="replace-me-too"
